# Snakemake
.snakemake/
results/
tests/workflow/results*/
# tests/workflow/fixtures/ is TRACKED: it is the committed example data.
# Verify with: python3 tests/workflow/make_fixtures.py --check

# Large sequencing files belong on the share, not in git
*.bam
*.bai
*.cram
!tests/workflow/fixtures/*.bam

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS cruft
.DS_Store
Thumbs.db
